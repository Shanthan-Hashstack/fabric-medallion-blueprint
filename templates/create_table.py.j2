from pyspark.sql.types import (
    StructType, StructField, StringType, IntegerType, LongType, ShortType,
    DoubleType, FloatType, DecimalType, BooleanType, DateType, TimestampType,
    BinaryType,
)
from delta.tables import DeltaTable

SCHEMA = "{{ lakehouse }}_{{ layer.name }}"
TABLE = "{{ layer.table_prefix }}{{ table.name }}"
FQN = f"{SCHEMA}.{TABLE}"

builder = (
    DeltaTable.createIfNotExists(spark)
    .tableName(FQN)
    # ---- Business columns (from manifest) --------------------------------
{% for col in table.columns %}
    .addColumn("{{ col.name }}", {{ col.type | spark_struct_type }}, nullable={{ col.nullable }})
{% endfor %}
    # ---- Mandatory audit columns ({{ layer.name }} layer) ----------------
{% for col in audit_columns %}
    .addColumn("{{ col.name }}", {{ col.type | spark_struct_type }})
{% endfor %}
)
{% if table.partition_by %}
builder = builder.partitionedBy({{ table.partition_by | list_literal }})
{% endif %}
builder.execute()

# ---- Apply standard table properties -------------------------------------
{% for key, value in table_properties.items() %}
spark.sql(f"ALTER TABLE {FQN} SET TBLPROPERTIES ('{{ key }}' = '{{ value }}')")
{% endfor %}

print(f"[TABLE] {FQN} created/verified with "
      f"{{ table.columns | length }} business + {{ audit_columns | length }} audit columns.")
